flare_traffic_light: flare.traffic.train_r
{


	semaphore_states[]: red
@include "tr_light_flares_scale.sui"
	lamp_color_slot: red
	lamp_color_index: 0

}

flare_traffic_light: flare.traffic.train_w
{

	semaphore_states[]: red
@include "tr_light_flares_scale.sui"
	lamp_color_slot: orange
	lamp_color_index: 3

}

flare_traffic_light: flare.traffic.toll_w
{

	semaphore_states[]: green
@include "tr_light_flares_scale.sui"
	lamp_color_slot: green
	lamp_color_index: 3

}


flare_traffic_light: flare.traffic.red.blink.shift.slot0
{
    setup: lumen_hue_saturation
    ambient_color: (0, 0, 100)
    diffuse_color: (25, 0, 100)
    specular_color: (25, 0, 100)

    type: spot

    range: 30.0
    cut_range: 10.0
    inner_angle: 20.0
    outer_angle: 90.0
    forward_distance: false

    dir_type: angle
    flare_inner_angle: 2.0
    flare_outer_angle: 110.0

    pitch_offset: -65
    fade_distance: 200
    fade_span: 100

    lamp_color_slot: orange        # 'orange' slot will blink
    lamp_color_index: 0        # 'red' color will be used for 'orange' slot
    semaphore_states[]: red
    semaphore_states[]: orange_to_red
    semaphore_states[]: orange_to_green

    blink_delay_on: 0.5
    blink_delay_off: 0.5
    model: "/model/flare/tr_red.pmd"
@include "tr_light_flares_scale.sui"
}

flare_traffic_light: flare.traffic.red.blink.shift.slot1
{
    setup: lumen_hue_saturation
    ambient_color: (0, 0, 100)
    diffuse_color: (25, 0, 100)
    specular_color: (25, 0, 100)

    type: spot

    range: 30.0
    cut_range: 10.0
    inner_angle: 20.0
    outer_angle: 90.0
    forward_distance: false

    dir_type: angle
    flare_inner_angle: 2.0
    flare_outer_angle: 110.0

    pitch_offset: -65
    fade_distance: 200
    fade_span: 100

    lamp_color_slot: red        # 'red' slot will blink
    lamp_color_index: 0        # 'red' color will be used for 'orange' slot
    semaphore_states[]: red
    semaphore_states[]: orange_to_red
    semaphore_states[]: orange_to_green

    blink_delay_on: 0.5
    blink_delay_off: 0.5
    blink_cycle_shift: 0.5
    model: "/model/flare/tr_red.pmd"
@include "tr_light_flares_scale.sui"
}

