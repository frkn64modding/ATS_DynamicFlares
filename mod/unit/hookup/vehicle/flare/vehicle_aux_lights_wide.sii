SiiNunit
{
flare_vehicle: flare.vehicle.aux_light.wide
{
	dir_type: wide
	flare_inner_angle: 20
	light_type: aux
	model: "/model/flare/uniform_white.pmd"

@include "vehicle_bulb_type_incandescent.sui"

	# Frkn64 Modding 
	# Realistic Vehicle Lights Mod
	
	type: spot
	inner_angle: 30.0
	outer_angle: 62.0
	range: 20.0
	forward_distance: false
	pitch_offset: 4
	setup: candela_hue_saturation
	diffuse_color: (220, 0, 0)
	specular_color: (300, 0, 0)
	ambient_color: (0.08, 0, 0)
	default_scale: 0.10
	scale_factor: 44
	
@include "vehicle_lights_scaling_distance_beam.sui"
}
}
