SiiNunit
{
flare_vehicle: flare.vehicle.brakel_nolgh
{
	dir_type: wide
	light_type: brake

	range: 0.0  # disable light source

	model: "/model/flare/uniform_red.pmd"
	default_scale: 0.05
	scale_factor: 36
@include "vehicle_lights_scaling_distance_signal.sui"
@include "vehicle_bulb_type_incandescent.sui"
}
}
