SiiNunit
{

##########################
#
#  Players beacons
#
##########################

beacon_vehicle: flare.vehicle.beacon
{
	rot_speed: 720
	dir_type: wide
	light_type: beacon

@include "vehicle_spot_beacon_rotating_orange.sui"
	pitch_offset: 6

	model: "/model/flare/uniform_orange_amplified.pmd"
@include "vehicle_spot_beacon_scale_small.sui"

	fake_interior_offset: 1.5

@include "vehicle_bulb_type_incandescent.sui"
}

flare_blink: flare_only.vehicle.beacon.blink_l
{
	dir_type: wide

	light_type: beacon

	blink_pattern: "X-X-------"
	blink_step_length: 0.09

	model: "/model/flare/uniform_orange_amplified.pmd"
@include "vehicle_spot_beacon_scale_small.sui"

	fake_interior_offset: 1.5

@include "vehicle_bulb_type_led.sui"
}

flare_blink: light_only.vehicle.beacon.blink_l
{
	light_type: beacon

	blink_pattern: "X-X-------"
	blink_step_length: 0.09

@include "vehicle_spot_beacon_flashing_orange.sui"
	pitch_offset: 12

	fake_interior_offset: 1.5

@include "vehicle_bulb_type_led.sui"
}

flare_blink: flare_only.vehicle.beacon.blink_r
{
	dir_type: wide

	light_type: beacon

	blink_pattern: "----X-X---"
	blink_step_length: 0.09

	model: "/model/flare/uniform_orange_amplified.pmd"
@include "vehicle_spot_beacon_scale_small.sui"

	fake_interior_offset: 1.5

@include "vehicle_bulb_type_led.sui"
}

flare_blink: light_only.vehicle.beacon.blink_r
{
	light_type: beacon

	blink_pattern: "----X-X---"
	blink_step_length: 0.09

@include "vehicle_spot_beacon_flashing_orange.sui"
	pitch_offset: 12

	fake_interior_offset: 1.5

@include "vehicle_bulb_type_led.sui"
}

flare_blink: flare.vehicle.beacon_addon.blink
{
	dir_type: wide

	light_type: beacon

	blink_pattern: "X-X-X--------X-X-X--------X-X-X--------XXXXX----------XXXXX----------"
	blink_step_length: 0.06

@include "vehicle_spot_beacon_addon_flashing_orange.sui"

	model: "/model/flare/uniform_orange_amplified.pmd"
	default_scale: 0.15
	scale_factor: 12

@include "vehicle_bulb_type_led.sui"
}

