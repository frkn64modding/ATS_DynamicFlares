#
# Utility blinking (aka road signalization trailers)
#
##########################

flare_blink: flare.vehicle.emergency.beacon_o.blink_slow
{
	dir_type: wide
	blink_pattern: "X--"
	blink_step_length: 0.5

	light_type: police_hooter

	range: 0.0  # disable light source

	model: "/model/flare/uniform_orange_amplified.pmd"
@include "vehicle_spot_beacon_scale_small.sui"

@include "vehicle_bulb_type_led.sui"
}

