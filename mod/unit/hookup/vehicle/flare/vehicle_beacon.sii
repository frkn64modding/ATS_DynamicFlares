SiiNunit
{
beacon_vehicle: flare.vehicle.beacon	#use only for truck! fake_interior_offset: 1.0
{
    fake_interior_offset: 1.0
	rot_speed: 720
	dir_type: wide
	light_type: beacon

@include "vehicle_spot_beacon_rotating_orange.sui"
	pitch_offset: 6

	model: "/model/flare/uniform_orange_amplified.pmd"
@include "vehicle_spot_beacon_scale_small.sui"

@include "vehicle_bulb_type_incandescent.sui"
}

flare_blink: flare_only.vehicle.beacon.blink_l	# use only for truck together with light_only.*
{
	fake_interior_offset: 0.0	# since it's flare only we don't need offset
	dir_type: wide

	light_type: beacon

	blink_pattern: "X-X-------"
	blink_step_length: 0.09

	range: 0.0  # disable light source

	model: "/model/flare/uniform_orange_amplified.pmd"
@include "vehicle_spot_beacon_scale_small.sui"

@include "vehicle_bulb_type_led.sui"
}

flare_blink: light_only.vehicle.beacon.blink_l	# use only for truck together with flare_only.*
{
	fake_interior_offset: 1.5
	light_type: beacon

	blink_pattern: "X-X-------"
	blink_step_length: 0.09

@include "vehicle_spot_beacon_flashing_orange.sui"
	pitch_offset: 12

@include "vehicle_bulb_type_led.sui"
}

flare_blink: flare_only.vehicle.beacon.blink_r	# use only for truck together with light_only.*
{
	fake_interior_offset: 0.0	# since it's flare only we don't need offset
	dir_type: wide
	light_type: beacon

	blink_pattern: "----X-X---"
	blink_step_length: 0.09

	range: 0.0  # disable light source

	model: "/model/flare/uniform_orange_amplified.pmd"
@include "vehicle_spot_beacon_scale_small.sui"

@include "vehicle_bulb_type_led.sui"
}

flare_blink: light_only.vehicle.beacon.blink_r	# use only for truck together with flare_only.*
{
	fake_interior_offset: 1.5
	light_type: beacon

	blink_pattern: "----X-X---"
	blink_step_length: 0.09

@include "vehicle_spot_beacon_flashing_orange.sui"

@include "vehicle_bulb_type_led.sui"
}

