#
# Emergency (aka police, ambulance & firetrucks) beacons
#
##########################

beacon_vehicle: flare.vehicle.emergency.beacon_r
{
	rot_speed: 720
	dir_type: wide
	light_type: police_hooter

@include "vehicle_spot_beacon_rotating_red.sui"
	pitch_offset: 6

	model: "/model/flare/uniform_red_amplified.pmd"
	visual_offset: 0.75
@include "vehicle_spot_beacon_scale_big.sui"

@include "vehicle_bulb_type_incandescent.sui"
}

beacon_vehicle: flare.vehicle.emergency.beacon_b
